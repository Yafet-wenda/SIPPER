# Template untuk deploy sungguhan (HTTPS + SMTP + ClamAV aktif).
# Untuk XAMPP lokal tanpa TLS, gunakan: DJANGO_SECURE_COOKIES=0,
# DJANGO_SECURE_SSL_REDIRECT=0, DJANGO_HSTS_SECONDS=0, DB_HOST=127.0.0.1,
# dan DJANGO_EMAIL_BACKEND=console agar halaman reset password tidak gagal kirim.
# Catatan: prod.bat menyetel enam nama di lingkungan prosesnya - DJANGO_DEBUG,
# DJANGO_ALLOWED_HOSTS, DJANGO_CSRF_TRUSTED_ORIGINS, DJANGO_SECURE_SSL_REDIRECT,
# DJANGO_SECURE_COOKIES, DJANGO_HSTS_SECONDS - dan python-dotenv tidak menimpa
# variabel yang sudah ada. Nilai lain (DB_HOST, DJANGO_EMAIL_BACKEND, CLAMAV_*)
# tetap dibaca dari .env, jadi jangan mengandalkannya untuk dev.
# Bawaan DJANGO_DEBUG di settings adalah 0, sehingga dev.bat yang menyetel 1;
# kalau menjalankan manage.py runserver manual, set lebih dulu
# "set DJANGO_DEBUG=1" supaya halaman galat development muncul.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_SECURE_COOKIES=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000
DB_ENGINE=mysql
DB_NAME=sipper_db
DB_USER=sipper_app
DB_PASSWORD=replace-me
DB_HOST=db
DB_PORT=3306
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=wenda@example.com
DJANGO_EMAIL_HOST_PASSWORD=replace-me
DJANGO_EMAIL_USE_TLS=1
DJANGO_DEFAULT_FROM_EMAIL=SIPPER <wensa@example.com>
# Batang waktu tunggu SMTP dalam detik; tanpa ini satu server mail yang
# menggantung bisa menahan permintaan pengguna.
DJANGO_EMAIL_TIMEOUT=10
# Hanya dipakai bila DJANGO_EMAIL_BACKEND=file. Berkas surat masuk ke folder
# ini (relatif terhadap folder proyek) dan tidak pernah disajikan lewat URL.
DJANGO_EMAIL_FILE_PATH=tmp/outbox
CLAMAV_ENABLED=1
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Asisten verifikasi dokumen (opsional). Isi kunci Google AI Studio untuk
# mengaktifkan LLM Gemini; kosong/hapus = asisten menjawab dengan mesin
# aturan lokal. GEMINI_MODEL opsional, bawaannya gemini-2.5-flash.
# Catatan privasi: saat kunci terisi, ringkasan data pengajuan (nama, NIK)
# dikirim ke server Google sebagai konteks percakapan.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
