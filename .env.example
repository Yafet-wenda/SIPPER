# Template untuk deploy sungguhan (HTTPS + SMTP + ClamAV aktif).
# Untuk XAMPP lokal tanpa TLS, gunakan: DJANGO_SECURE_COOKIES=0,
# DJANGO_SECURE_SSL_REDIRECT=0, DJANGO_HSTS_SECONDS=0, DB_HOST=127.0.0.1,
# dan DJANGO_EMAIL_BACKEND=console agar halaman reset password tidak gagal kirim.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_SECURE_COOKIES=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000
DB_ENGINE=mysql
DB_NAME=sipper_db
DB_USER=sipper_app
DB_PASSWORD=replace-me
DB_HOST=db
DB_PORT=3306
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=wenda@example.com
DJANGO_EMAIL_HOST_PASSWORD=replace-me
DJANGO_EMAIL_USE_TLS=1
DJANGO_DEFAULT_FROM_EMAIL=SIPPER <wensa@example.com>
CLAMAV_ENABLED=1
CLAMAV_HOST=clamav
CLAMAV_PORT=3310